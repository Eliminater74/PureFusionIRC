<Application x:Class="PureFusionIRC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000"/>
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#070B12"/>
            <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#0A1522"/>
            <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#000000"/>
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0A1624"/>
            <SolidColorBrush x:Key="TreeBackgroundBrush" Color="#05080D"/>
            <SolidColorBrush x:Key="NickListBackgroundBrush" Color="#05080D"/>
            <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#0A1522"/>
            <SolidColorBrush x:Key="BorderBrushKey" Color="#2A5A8C"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="DimTextBrush" Color="#A8C0D8"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#4FC3F7"/>
            <SolidColorBrush x:Key="SelectionBrush" Color="#1565C0"/>
            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#102A43"/>
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1A4A73"/>
            <SolidColorBrush x:Key="ButtonPressedBrush" Color="#0D3A66"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4FC3F7"/>
            <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#0B1828"/>
            <SolidColorBrush x:Key="MenuHighlightBrush" Color="#1565C0"/>
            <SolidColorBrush x:Key="MenuHighlightTextBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentFillBrush" Color="#1E88E5"/>
            <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="HighlightBrush" Color="#FF8A65"/>
            <SolidColorBrush x:Key="SelfNickBrush" Color="#80CBC4"/>
            <SolidColorBrush x:Key="OtherNickBrush" Color="#90CAF9"/>
            <SolidColorBrush x:Key="ActionBrush" Color="#CE93D8"/>
            <SolidColorBrush x:Key="LinkBrush" Color="#64B5F6"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#EF9A9A"/>
            <SolidColorBrush x:Key="JoinBrush" Color="#A5D6A7"/>
            <SolidColorBrush x:Key="PartBrush" Color="#FFAB91"/>
            <SolidColorBrush x:Key="ChannelBrush" Color="#FFE082"/>
            <SolidColorBrush x:Key="QueryBrush" Color="#81D4FA"/>
            <SolidColorBrush x:Key="UnreadBrush" Color="#81C784"/>
            <SolidColorBrush x:Key="MentionBrush" Color="#FFCC80"/>
            <SolidColorBrush x:Key="NickOwnerBrush" Color="#E8C547"/>
            <SolidColorBrush x:Key="NickAdminBrush" Color="#EF9A9A"/>
            <SolidColorBrush x:Key="NickOpBrush" Color="#FF6B6B"/>
            <SolidColorBrush x:Key="NickHalfopBrush" Color="#FFB74D"/>
            <SolidColorBrush x:Key="NickVoiceBrush" Color="#64B5F6"/>
            <SolidColorBrush x:Key="NickRegularBrush" Color="#F5F5F5"/>
            <FontFamily x:Key="ThemeFontFamily">Consolas</FontFamily>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style x:Key="PfTreeViewItem" TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theming/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
