<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PureFusionIRC.Core\PureFusionIRC.Core.csproj" />
    <Resource Include="Assets\PureFusionIRC.ico" />
    <Resource Include="Assets\PureFusionIRC.png" />
    <Content Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Keep WPF names (Application, Color, KeyEventArgs) unambiguous; tray uses explicit WinForms usings. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\PureFusionIRC.ico</ApplicationIcon>
    <AssemblyName>PureFusionIRC</AssemblyName>
    <RootNamespace>PureFusionIRC.App</RootNamespace>
    <ApplicationManifest>PureFusionIRC.exe.manifest</ApplicationManifest>
    <ApplicationTitle>PureFusionIRC</ApplicationTitle>
    <Description>Windows IRC client with an mIRC-style layout and a full theme engine.</Description>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <!-- WinExe = Windows GUI .exe (same class as mIRC), not a macOS .app bundle. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
