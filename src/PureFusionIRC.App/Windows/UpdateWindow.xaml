<Window x:Class="PureFusionIRC.App.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updates — PureFusionIRC"
        Height="520" Width="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,10"/>
            <DockPanel LastChildFill="False">
                <Button x:Name="InstallButton" Content="Download and install" Width="160"
                        Style="{StaticResource AccentButton}" Click="Install_Click"/>
                <Button Content="Open GitHub" Width="110" Margin="8,0,0,0" Click="Web_Click"/>
                <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True" HorizontalAlignment="Right"/>
            </DockPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="StatusBlock" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
        <TextBlock DockPanel.Dock="Top" x:Name="MetaBlock" TextWrapping="Wrap"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
        <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True" FontFamily="Segoe UI" FontSize="13"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource ButtonBorderBrush}" Padding="10"/>
    </DockPanel>
</Window>
