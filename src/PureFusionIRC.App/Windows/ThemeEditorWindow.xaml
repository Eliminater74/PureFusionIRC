<Window x:Class="PureFusionIRC.App.Windows.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme editor — PureFusionIRC"
        Height="640" Width="920"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource DimTextBrush}" Margin="0,0,0,10"
                   Text="Change any color. The main window updates as you click. Save writes JSON under AppData\PureFusionIRC\themes. Fonts stay in Tools → Options."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Close" Width="90" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Themes" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Duplicate…" Margin="0,0,0,6" Click="Duplicate_Click"/>
                    <Button Content="Reset to factory" Margin="0,0,0,6" Click="Reset_Click"/>
                    <Button Content="Delete" Margin="0,0,0,6" Click="Delete_Click"/>
                    <Button Content="Open themes folder" Click="OpenFolder_Click"/>
                </StackPanel>
                <ListBox x:Name="ThemeList" DisplayMemberPath="Name"
                         Background="{DynamicResource PanelBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderBrush="{DynamicResource BorderBrushKey}"
                         SelectionChanged="ThemeList_SelectionChanged"/>
            </DockPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Label Content="Name"/>
                    <TextBox x:Name="NameBox" Margin="0,0,0,8" TextChanged="Meta_Changed"/>
                    <Label Content="Description"/>
                    <TextBox x:Name="DescBox" Margin="0,0,0,8" TextChanged="Meta_Changed"/>
                    <CheckBox x:Name="DarkBox" Content="Dark theme (chrome fallbacks)" Margin="0,0,0,12" Click="Dark_Click"/>
                    <StackPanel x:Name="FieldsHost"/>
                    <Label Content="mIRC color codes 0–15" Margin="0,8,0,4"/>
                    <WrapPanel x:Name="PaletteHost"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
