<Window x:Class="PureFusionIRC.App.Windows.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options — PureFusionIRC"
        Height="480" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
        <TabControl Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushKey}">
            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="TimestampsBox" Content="Show timestamps" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ReconnectBox" Content="Reconnect if the server drops (after 5 failures use the next listed server)" Margin="0,0,0,8"/>
                    <CheckBox x:Name="HideJoinBox" Content="Hide join/part/quit" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StripColorBox" Content="Strip mIRC color codes" Margin="0,0,0,8"/>
                    <CheckBox x:Name="LogBox" Content="Log buffers to disk (folder is created; writer in a later milestone)" Margin="0,0,0,8"/>
                    <CheckBox x:Name="MotdBox" Content="Show MOTD" Margin="0,0,0,12"/>
                    <Label Content="Tray"/>
                    <CheckBox x:Name="MinimizeTrayBox" Content="Minimize to tray" Margin="0,0,0,8"/>
                    <CheckBox x:Name="CloseTrayBox" Content="Close to tray (X hides; use File → Exit to quit)" Margin="0,0,0,8"/>
                    <CheckBox x:Name="NotifyTrayBox" Content="Tray notifications (highlights, queries, disconnect)" Margin="0,0,0,12"/>
                    <Label Content="Timestamp format"/>
                    <TextBox x:Name="TimestampBox" Margin="0,0,0,8"/>
                    <Label Content="Font family"/>
                    <TextBox x:Name="FontBox" Margin="0,0,0,8"/>
                    <Label Content="Font size"/>
                    <TextBox x:Name="FontSizeBox" Margin="0,0,0,8"/>
                    <Label Content="Highlight words (comma separated)"/>
                    <TextBox x:Name="HighlightBox"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Files">
                <StackPanel Margin="12">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DimTextBrush}" Margin="0,0,0,12"
                               Text="Direct transfers (DCC) go computer-to-computer. Reverse mode is easier at home because the other side opens a port."/>
                    <CheckBox x:Name="DccBox" Content="Allow sending and receiving files" Margin="0,0,0,8"/>
                    <CheckBox x:Name="DccReverseBox" Content="Prefer reverse DCC (no port forwarding on your side)" Margin="0,0,0,12"/>
                    <Label Content="Save incoming files to (blank = AppData\PureFusionIRC\transfers)"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Browse…" Width="90" Margin="8,0,0,0" Click="BrowseFolder_Click"/>
                        <TextBox x:Name="DccFolderBox"/>
                    </DockPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Identity">
                <StackPanel Margin="12">
                    <Label Content="Nick"/>
                    <TextBox x:Name="NickBox" Margin="0,0,0,8"/>
                    <Label Content="Alternative nick"/>
                    <TextBox x:Name="AltBox" Margin="0,0,0,8"/>
                    <Label Content="Username"/>
                    <TextBox x:Name="UserBox" Margin="0,0,0,8"/>
                    <Label Content="Real name"/>
                    <TextBox x:Name="RealBox"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
