<Window x:Class="PureFusionIRC.App.Windows.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new — PureFusionIRC"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="Check for updates…" Width="150" Click="Updates_Click"/>
            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True" HorizontalAlignment="Right"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="VersionBlock" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource DimTextBrush}"
                   Text="What landed in this build. GitHub Releases carry the same notes when you update."/>
        <TextBox x:Name="BodyBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True" FontFamily="Segoe UI" FontSize="13"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource ButtonBorderBrush}" Padding="10"/>
    </DockPanel>
</Window>
