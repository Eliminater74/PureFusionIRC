<Window x:Class="PureFusionIRC.App.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PureFusionIRC"
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="GitHub" Width="100" Margin="0,0,8,0" Click="GitHub_Click"/>
            <Button Content="Releases" Width="100" Margin="0,0,8,0" Click="Releases_Click"/>
            <Button Content="Close" Width="90" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="TitleBlock" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DimTextBrush}" Margin="0,0,0,14"
                       Text="Windows C# IRC client inspired by mIRC. Scripts are JavaScript (.pf.js), not mIRC script. MIT License."/>
            <TextBlock Text="GitHub" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
            <TextBlock x:Name="StatsBlock" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Text="Loading download counts…"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DimTextBrush}" Margin="0,12,0,0"
                       Text="Installer counts are GitHub’s download_count on every PureFusionIRC-*-setup.exe. Zip is the portable archive. README visitors use the badge on the repository page (GitHub caches images, so that number is approximate)."/>
        </StackPanel>
    </DockPanel>
</Window>
