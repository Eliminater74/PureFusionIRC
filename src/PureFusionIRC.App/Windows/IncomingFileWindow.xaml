<Window x:Class="PureFusionIRC.App.Windows.IncomingFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming file"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save file" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Decline" Width="90" IsCancel="True" Click="Decline_Click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Someone wants to send you a file" Foreground="{DynamicResource DimTextBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="FileNameBlock" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
            <TextBlock x:Name="MetaBlock" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DimTextBrush}"
                       Text="This is a direct transfer (DCC). The file comes from their computer, not the IRC server. Save only if you trust them."/>
            <TextBlock x:Name="HowBlock" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource DimTextBrush}"/>
            <TextBlock x:Name="SaveBlock" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource DimTextBrush}"/>
            <TextBlock x:Name="RiskBlock" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
