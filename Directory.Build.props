<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>PureFusion</Company>
    <Product>PureFusionIRC</Product>
    <Authors>PureFusionIRC contributors</Authors>
    <Copyright>Copyright (c) PureFusionIRC contributors</Copyright>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>B3</VersionSuffix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.3</FileVersion>
    <InformationalVersion>1.0.0-B3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
</Project>
